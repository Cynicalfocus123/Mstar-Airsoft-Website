{
  "name": "mstar-airsoft-website",
  "private": true,
  "version": "0.1.0",
  "homepage": "https://cynicalfocus123.github.io/Mstar-Airsoft-Website/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cynicalfocus123/Mstar-Airsoft-Website.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:github-pages": "tsc -b && vite build --mode github-pages && node scripts/create-spa-fallback.mjs",
    "build:cpanel": "tsc -b && vite build --mode cpanel",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "country-region-data": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.16"
  }
}
